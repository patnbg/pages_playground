{
  "openapi": "3.0.3",
  "info": {
    "title": "Test API",
    "description": "Eine einfache Test-API für GitHub Pages + Scalar",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Local Dev"
    }
  ],
  "paths": {
    "/hello": {
      "get": {
        "summary": "Hello World Endpoint",
        "description": "Gibt einen einfachen Test-String zurück",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "example": {
                  "message": "Hello World"
                }
              }
            }
          }
        }
      }
    },
    "/users/{id}": {
      "get": {
        "summary": "User by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "User found",
            "content": {
              "application/json": {
                "example": {
                  "id": 1,
                  "name": "Max Mustermann"
                }
              }
            }
          }
        }
      }
    }
  }
}
